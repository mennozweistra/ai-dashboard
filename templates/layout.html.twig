<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}tm{% endblock %}</title>
    <link rel="stylesheet" href="/static/style.css">
    <script src="/static/app.js" defer></script>
</head>
<body>
<header class="site-header">
    <div class="site-header-inner">
        {% block breadcrumb %}<a href="/" class="home">tm</a>{% endblock %}
    </div>
    {% set titleline %}{% block titleline %}{% endblock %}{% endset %}
    {% if titleline|trim is not empty %}
    <div class="site-header-title">{{ titleline|raw }}</div>
    {% endif %}
</header>
<main>
    {% block content %}{% endblock %}
</main>
</body>
</html>
